generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FollowStatus {
  PENDING
  APPROVED
}

enum LikeyTier {
  LIKED
  FINE
  DISLIKED
}

enum NotificationType {
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  NEW_LIKEY
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  username           String   @unique
  passwordHash       String
  defaultRadiusMiles Int      @default(10)
  profilePhotoUrl    String?
  createdAt          DateTime @default(now())

  likeys              Likey[]
  followsSent         Follow[]            @relation("FollowsSent")
  followsReceived     Follow[]            @relation("FollowsReceived")
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]      @relation("NotificationsReceived")
  pushTokens          PushToken[]
}

// A device's Expo push token. A user can have several (multiple devices, or
// a reinstall issuing a new token) — token itself is the unique key so a
// re-registration from any account just moves it to the current user.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// In-app notification feed. actorId is who triggered it (nullable so the
// row survives if that user is ever deleted); data carries the id needed to
// deep-link (e.g. the Follow id or Likey id).
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  actorId   String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation("NotificationsReceived", fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// A 6-digit code emailed on /auth/forgot-password, redeemed by
// /auth/reset-password. Stored hashed (like passwordHash) so a DB read
// alone can't be used to reset someone's password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// One-directional: follower -> followee, request + approve (see product decisions log)
model Follow {
  id         String       @id @default(uuid())
  followerId String
  followeeId String
  status     FollowStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  follower User @relation("FollowsSent", fields: [followerId], references: [id])
  followee User @relation("FollowsReceived", fields: [followeeId], references: [id])

  @@unique([followerId, followeeId])
}

model Business {
  id              String   @id @default(uuid())
  name            String
  category        String
  // Only set when category = "general" — one of the fixed service types
  // (Landscaping, Painting, HVAC, Electrical, Plumbing, Drywall, General Repair).
  subcategory     String?
  address         String?
  city            String?
  state           String?
  // Contact info for a General (service-provider) recommendation — surfaced
  // so a follower can actually reach out, not just read a rating.
  phone           String?
  email           String?
  // Nullable: "general" (service-provider) businesses are manually entered
  // with no Apple Maps lookup, so there's no coordinate to geocode — they're
  // surfaced by search, never by GPS radius, so this is fine to leave unset.
  latitude        Float?
  longitude       Float?
  externalPlaceId String?  @unique
  createdAt       DateTime @default(now())

  likeys Likey[]
}

model Likey {
  id         String    @id @default(uuid())
  userId     String
  businessId String
  tier       LikeyTier
  comment    String?
  photoUrl   String?
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([userId])
}
